# Integration example for the TEAM'S migrated Node.js server.
# Not a runnable Dockerfile for the current Workers/D1 checkout.
# Prepend the team's Debian bookworm Node.js build stage named site-build.
# It must produce a self-contained /app/runtime with server.js and dependencies.
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS pii-deps
COPY services/pii/requirements.lock.txt /tmp/pii-requirements.txt
RUN python -m venv /opt/pii && /opt/pii/bin/pip install --no-cache-dir -r /tmp/pii-requirements.txt && /opt/pii/bin/pip check

FROM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS node-runtime
# Retain Python's OS libraries (including OpenSSL); add the Node executable.
# Site artifacts must target the same Node major, Debian/glibc and architecture.
FROM pii-deps AS combined
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
RUN groupadd --gid 10001 criterion && useradd --uid 10001 --gid criterion --no-create-home --shell /usr/sbin/nologin criterion
WORKDIR /app
COPY --from=site-build --chown=criterion:criterion /app/runtime/ /app/
COPY --chown=criterion:criterion services/pii/__init__.py services/pii/app.py services/pii/detector.py services/pii/healthcheck.py /app/services/pii/
COPY --chown=criterion:criterion scripts/run-with-pii.mjs scripts/check-pii-endpoint.py /app/scripts/
ENV NODE_ENV=production PORT=3000 PII_PYTHON=/opt/pii/bin/python \
    PATH=/opt/pii/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=6s --start-period=150s --retries=3 CMD ["node", "scripts/run-with-pii.mjs", "--healthcheck"]
ENTRYPOINT ["node", "scripts/run-with-pii.mjs", "--"]
CMD ["node", "server.js"]
