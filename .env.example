# Copy to ignored .dev.vars for local Workers; use server secrets on hosting.
# Never paste live terminal credentials into this tracked example.
TBANK_ENABLED=false
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_PUBLIC_URL=https://criterion-publish-diagnostic-20261113.serenewisteria2.chatgpt.site
# DEMO and live terminals normally use securepay. Change only per bank guidance.
TBANK_API_URL=https://securepay.tinkoff.ru/v2/
# Optional authenticated transport through the user's VPS. DEMO only.
TBANK_GATEWAY_URL=
TBANK_GATEWAY_SECRET=
# Selected: T-Business Checks (1.5%); sends Receipt in Init.
# Connected in the bank cabinet; finish configuration and testing before enabling checkout.
TBANK_RECEIPT_MODE=bank
# Merchant confirmed AutoUSN Income (8%). T-Bank uses the usn_income code for it.
TBANK_TAXATION=usn_income
# This merchant's own Criterion services under AutoUSN: no VAT (not a zero VAT rate).
TBANK_TAX=none
# Immediate delivery of the completed contract: service, full settlement.
TBANK_PAYMENT_METHOD=full_payment
TBANK_PAYMENT_OBJECT=service

# Live gateway is separate; mode must be explicitly live.
TBANK_MODE=demo
TBANK_NOTIFICATION_URL=
