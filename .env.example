# Copy to ignored .env for local Docker; set runtime secrets in Amvera.
# Never paste live terminal credentials into this tracked example.

# Auth email: verify the sending domain in Resend and disable open/click tracking.
RESEND_API_KEY=
EMAIL_FROM=
AUTH_PUBLIC_URL=http://localhost:3000
# Optional: one real monitored mailbox, no display name. Blank omits Reply-To.
EMAIL_REPLY_TO=

TBANK_ENABLED=false
TBANK_TERMINAL_KEY=
# Set only one password form. For Amvera special characters use Base64 of UTF-8.
TBANK_PASSWORD=
TBANK_PASSWORD_BASE64=
TBANK_PUBLIC_URL=https://criterion-stage.example.com
# DEMO and live terminals normally use securepay. Change only per bank guidance.
TBANK_API_URL=https://securepay.tinkoff.ru/v2/
# Optional authenticated transport through the user's VPS. DEMO only.
TBANK_GATEWAY_URL=
TBANK_GATEWAY_SECRET=
# Selected: T-Business Checks (1.5%); sends Receipt in Init.
# Connected in the bank cabinet; finish configuration and testing before enabling checkout.
TBANK_RECEIPT_MODE=bank
# Merchant confirmed AutoUSN Income (8%). T-Bank uses the usn_income code for it.
TBANK_TAXATION=usn_income
# This merchant's own Criterion services under AutoUSN: no VAT (not a zero VAT rate).
TBANK_TAX=none
# Immediate delivery of the completed contract: service, full settlement.
TBANK_PAYMENT_METHOD=full_payment
TBANK_PAYMENT_OBJECT=service

# Live gateway is separate; mode must be explicitly live.
TBANK_MODE=demo
TBANK_NOTIFICATION_URL=

# Model calls require a trusted server-side PII detector (see docs/privacy/README.md).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# PII_ANALYZER_URL is set automatically to the private loopback service.
# Generate a separate random token with at least 32 characters; never commit it.
PII_ANALYZER_TOKEN=

# Docker defaults; keep /data attached to persistent storage.
PORT=3000
DATABASE_PATH=/data/criterion.sqlite
# Set only if the hosting proxy overwrites this header; otherwise limits use a shared bucket.
TRUSTED_CLIENT_IP_HEADER=

# Server diagnostics. Set APP_RELEASE to the deployed revision.
LOG_LEVEL=info
SERVICE_NAME=criterion
APP_RELEASE=unknown
INSTANCE_ID=unknown
